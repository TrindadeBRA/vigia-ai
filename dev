#!/usr/bin/env bash
# Único script de desenvolvimento do Vigia AI.
# Substitui dev.sh, dev-collector.sh, dev-wokwi.sh e collector/start.sh.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MONITOR_BAUD=115200
BACKEND_PORT=8787
FRONTEND_PORT=5173
# wokwigw expõe a porta 80 da placa simulada em 127.0.0.1:9080 por padrão
# (forward embutido dele, sem precisar de --forward) — dá pra testar o
# upload de tema (protótipo, ver .agents/CONTRATO_TEMA.md) sem hardware real.
THEME_SIM_PORT=9080
WOKWIGW_BIN="$ROOT_DIR/.tools/wokwigw"
WOKWIGW_VERSION="v2.0.1"
WOKWIGW_ASSET=""
WOKWIGW_EXTRACTED="wokwigw"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)  WOKWIGW_ASSET="Linux_64bit"; WOKWIGW_EXTRACTED="wokwigw-linux" ;;
  Linux-aarch64|Linux-arm64) WOKWIGW_ASSET="Linux_ARM64"; WOKWIGW_EXTRACTED="wokwigw-linux" ;;
  Darwin-x86_64) WOKWIGW_ASSET="macOS_64bit"; WOKWIGW_EXTRACTED="wokwigw-darwin" ;;
  Darwin-arm64)  WOKWIGW_ASSET="macOS_ARM64"; WOKWIGW_EXTRACTED="wokwigw-darwin" ;;
  MINGW*|MSYS*|CYGWIN*) WOKWIGW_ASSET="Windows_64bit"; WOKWIGW_EXTRACTED="wokwigw.exe" ;;
esac
WOKWIGW_URL="https://github.com/wokwi/wokwigw/releases/download/${WOKWIGW_VERSION}/wokwigw_${WOKWIGW_VERSION}_${WOKWIGW_ASSET}.zip"

usage() {
  cat <<EOF
uso: ./dev <comando>

  ./dev                 esta ajuda
  ./dev up              backend FastAPI + frontend Vite
  ./dev up --docker     Compose na raiz
  ./dev down            encerra o que este script deixou em :8787 / :5173
  ./dev wokwi           coletor + gateway Wokwi + compila o firmware simulado
                     (atalhos: simulador, sim)
  ./dev firmware build  compila a placa (esp32dev)
  ./dev firmware wokwi  só compila o env wokwi (não sobe o gateway)
  ./dev firmware flash  grava na ESP32
  ./dev firmware monitor
  ./dev test            pytest + tsc
  ./dev lint            ruff

Ctrl+C encerra os processos que este script subiu.
EOF
}

find_pio() {
  if command -v pio >/dev/null 2>&1; then
    command -v pio
    return 0
  fi
  local bundled="$HOME/.platformio/penv/bin/pio"
  if [ -x "$bundled" ]; then
    printf '%s\n' "$bundled"
    return 0
  fi
  echo "erro: pio não encontrado. https://docs.platformio.org/" >&2
  exit 1
}

run_pio() {
  local pio
  pio="$(find_pio)"
  (cd "$ROOT_DIR/firmware" && "$pio" "$@")
}

ensure_python() {
  if [ ! -d "$ROOT_DIR/backend/.venv" ]; then
    python3 -m venv "$ROOT_DIR/backend/.venv"
  fi
  # Sempre sincroniza deps: venv antigo não ganhava pacotes novos (ex.: Pillow).
  "$ROOT_DIR/backend/.venv/bin/pip" install -q -e "$ROOT_DIR/backend[dev]"
}

ensure_node() {
  if [ ! -d "$ROOT_DIR/frontend/node_modules" ]; then
    (cd "$ROOT_DIR/frontend" && npm install)
  fi
}

ensure_frontend_dist() {
  # Sempre rebuilda: :8787 serve frontend/dist, e pular o build deixava o
  # mostrador da LAN / Wokwi com UI velha depois de mudar o React.
  ensure_node
  echo "== build frontend (painel na :${BACKEND_PORT} pra LAN / QR da placa) =="
  (cd "$ROOT_DIR/frontend" && npm run build)
}

ensure_wokwigw() {
  if [ -x "$WOKWIGW_BIN" ]; then
    return 0
  fi
  if [ -z "$WOKWIGW_ASSET" ]; then
    echo "plataforma não suportada: $(uname -s)-$(uname -m)" >&2
    echo "baixe manualmente em https://github.com/wokwi/wokwigw/releases/latest" >&2
    echo "e salve o binário em $WOKWIGW_BIN" >&2
    exit 1
  fi
  mkdir -p "$ROOT_DIR/.tools"
  echo "== baixando wokwigw para .tools/ =="
  if command -v curl >/dev/null 2>&1; then
    local tmpzip="$ROOT_DIR/.tools/wokwigw.zip"
    curl -fsSL -o "$tmpzip" "$WOKWIGW_URL" || {
      echo "falha no download. baixe em https://github.com/wokwi/wokwigw/releases/latest" >&2
      echo "e salve o binário em $WOKWIGW_BIN" >&2
      rm -f "$tmpzip"
      exit 1
    }
    if command -v unzip >/dev/null 2>&1; then
      unzip -qo "$tmpzip" -d "$ROOT_DIR/.tools/"
    else
      python3 -c "import zipfile,sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" "$tmpzip" "$ROOT_DIR/.tools/"
    fi
    # O zip contém um binário com nome específico por plataforma
    # (wokwigw-linux, wokwigw-darwin, wokwigw.exe).
    local extracted="$ROOT_DIR/.tools/$WOKWIGW_EXTRACTED"
    if [ -f "$extracted" ]; then
      mv "$extracted" "$WOKWIGW_BIN"
    fi
    rm -f "$tmpzip"
    # Limpa outros arquivos extraídos do zip
    rm -f "$ROOT_DIR/.tools"/wokwigw_* "$ROOT_DIR/.tools"/README* "$ROOT_DIR/.tools"/LICENSE* 2>/dev/null || true
  else
    echo "curl não encontrado; baixe wokwigw em https://github.com/wokwi/wokwigw/releases/latest" >&2
    exit 1
  fi
  chmod +x "$WOKWIGW_BIN"
}

warn_secrets() {
  local secrets="$ROOT_DIR/firmware/src/secrets.h"
  if [ ! -f "$secrets" ]; then
    echo "aviso: firmware/src/secrets.h não existe — cp firmware/src/secrets.h.example firmware/src/secrets.h" >&2
    echo ""
  fi
}

listen_pids() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null || true
}

require_port_free() {
  local port="$1"
  local name="$2"
  local pids
  pids="$(listen_pids "$port")"
  if [ -n "$pids" ]; then
    echo "erro: porta $port ($name) já está em uso — pid(s): $(echo "$pids" | tr '\n' ' ')" >&2
    echo "      encerre o outro processo (Ctrl+C naquele terminal) ou rode: ./dev down" >&2
    exit 1
  fi
}

PIDS=()
cleanup() {
  trap - INT TERM EXIT
  echo ""
  echo "encerrando..."
  for pid in "${PIDS[@]:-}"; do
    kill -TERM "$pid" 2>/dev/null || true
  done
  sleep 1
  for pid in "${PIDS[@]:-}"; do
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}

run_backend() {
  ensure_python
  ensure_frontend_dist
  echo "== backend FastAPI :${BACKEND_PORT} (Swagger em /docs) =="
  (
    cd "$ROOT_DIR/backend"
    exec .venv/bin/python -m app.main
  ) &
  local backend_pid=$!
  PIDS+=("$backend_pid")
  local i
  for i in $(seq 1 20); do
    if curl -sf -o /dev/null "http://127.0.0.1:${BACKEND_PORT}/health"; then
      return 0
    fi
    if ! kill -0 "$backend_pid" 2>/dev/null; then
      echo "erro: backend saiu antes de responder em /health (porta ${BACKEND_PORT} ocupada?)." >&2
      exit 1
    fi
    sleep 0.25
  done
  echo "erro: backend não respondeu em http://127.0.0.1:${BACKEND_PORT}/health" >&2
  exit 1
}

run_frontend() {
  ensure_node
  echo "== frontend Vite :${FRONTEND_PORT} (proxy para o backend) =="
  (
    cd "$ROOT_DIR/frontend"
    exec npm run dev -- --host 127.0.0.1 --port "$FRONTEND_PORT" --strictPort
  ) &
  PIDS+=("$!")
}

ours_on_port() {
  # Só os processos deste repo: python -m app.main (8787) e Vite (5173).
  local pid="$1"
  local cmd
  cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  case "$cmd" in
    *"/backend/"*"app.main"*|*python*" -m app.main"*) return 0 ;;
    *"vite"*|*"vigia-ai-frontend"*|*"frontend/node_modules"*) return 0 ;;
  esac
  return 1
}

cmd_down() {
  local pid port killed=0
  for port in "$BACKEND_PORT" "$FRONTEND_PORT"; do
    for pid in $(listen_pids "$port"); do
      if ours_on_port "$pid"; then
        echo "encerrando pid $pid (porta $port)"
        kill -TERM "$pid" 2>/dev/null || true
        killed=1
      else
        echo "aviso: porta $port em uso por pid $pid (não é deste repo) — não encerrado" >&2
      fi
    done
  done
  if [ "$killed" -eq 0 ]; then
    echo "nada deste repo escutando em :${BACKEND_PORT} / :${FRONTEND_PORT}"
    return 0
  fi
  sleep 1
  for port in "$BACKEND_PORT" "$FRONTEND_PORT"; do
    for pid in $(listen_pids "$port"); do
      if ours_on_port "$pid"; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    done
  done
  echo "portas livres."
}

cmd_up() {
  if [ "${1:-}" = "--docker" ]; then
    if ! command -v docker >/dev/null 2>&1; then
      echo "docker não encontrado." >&2
      exit 1
    fi
    echo "painel: http://127.0.0.1:${BACKEND_PORT}/display/config"
    exec docker compose -f "$ROOT_DIR/compose.yaml" up --build
  fi
  require_port_free "$BACKEND_PORT" "backend"
  require_port_free "$FRONTEND_PORT" "frontend Vite"
  trap cleanup INT TERM EXIT
  run_backend
  run_frontend
  echo ""
  echo "painel     http://127.0.0.1:${FRONTEND_PORT}/display/config"
  echo "mostrador  http://127.0.0.1:${FRONTEND_PORT}/display"
  echo "swagger    http://127.0.0.1:${BACKEND_PORT}/docs"
  echo "Ctrl+C encerra."
  wait
}

cmd_sim() {
  trap cleanup INT TERM EXIT
  ensure_wokwigw
  echo "== gateway wokwigw :9011 =="
  if nc -z 127.0.0.1 9011 2>/dev/null; then
    echo "gateway ja esta em :9011"
  else
    "$WOKWIGW_BIN" --listenPort 9011 &
    PIDS+=("$!")
    local i
    for i in $(seq 1 20); do
      if nc -z 127.0.0.1 9011 2>/dev/null; then
        break
      fi
      sleep 0.15
    done
  fi
  echo "== compilando firmware wokwi =="
  run_pio run -e wokwi
  if curl -sf -o /dev/null "http://127.0.0.1:${BACKEND_PORT}/health"; then
    echo "== backend ja esta em :${BACKEND_PORT} (reusa o ./dev up) =="
    ensure_frontend_dist
  else
    require_port_free "$BACKEND_PORT" "backend"
    run_backend
  fi
  echo ""
  echo "1. Se o simulador já estiver aberto: pare (Stop) e inicie de novo."
  echo "2. Cmd+Shift+P → Wokwi: Start Simulator"
  echo "3. Neste terminal deve aparecer: Client connected"
  echo "   se não aparecer, o Wokwi não está usando o gateway."
  echo ""
  echo "Editor de tema (/display/tema) na placa simulada: IP \"127.0.0.1:${THEME_SIM_PORT}\""
  echo "(o coletor detecta a placa como 127.0.0.1 — completa a porta à mão nesse campo)."
  echo "Ctrl+C encerra o gateway (e o backend, se este script o tiver subido)."
  wait
}

cmd_test() {
  ensure_python
  (cd "$ROOT_DIR/backend" && .venv/bin/pytest -q)
  ensure_node
  (cd "$ROOT_DIR/frontend" && npx tsc --noEmit)
}

cmd_lint() {
  ensure_python
  (cd "$ROOT_DIR/backend" && .venv/bin/ruff check app tests)
}

if [ $# -lt 1 ]; then
  usage
  exit 0
fi

case "$1" in
  -h|--help|help) usage ;;
  up) shift; cmd_up "$@" ;;
  down) cmd_down ;;
  wokwi|simulador|sim) cmd_sim ;;
  test) cmd_test ;;
  lint) cmd_lint ;;
  firmware)
    shift
    case "${1:-}" in
      build) warn_secrets; run_pio run -e esp32dev ;;
      wokwi) run_pio run -e wokwi ;;
      flash|upload) warn_secrets; run_pio run -e esp32dev -t upload ;;
      monitor) run_pio device monitor -b "$MONITOR_BAUD" ;;
      *)
        echo "uso: ./dev firmware {build|wokwi|flash|monitor}" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "comando desconhecido: $1" >&2
    usage >&2
    exit 1
    ;;
esac
