#!/usr/bin/env bash
# Único script de desenvolvimento do Vigia AI.
# Substitui dev.sh, dev-collector.sh, dev-wokwi.sh e collector/start.sh.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MONITOR_BAUD=115200
BACKEND_PORT=8787
FRONTEND_PORT=5173
# wokwigw expõe a porta 80 da placa simulada em 127.0.0.1:9080 por padrão
# (forward embutido dele, sem precisar de --forward) — dá pra testar o
# upload de tema (protótipo, ver .agents/CONTRATO_TEMA.md) sem hardware real.
THEME_SIM_PORT=9080
# Amarelo pros logs do gateway wokwigw (mesmo espírito do magenta em
# backend/app/http_util.py pras chamadas de saída — cada fonte com sua cor).
_GW_YELLOW='\033[33m'
_GW_RESET='\033[0m'
colorize_gateway() {
  if [ -t 1 ]; then
    while IFS= read -r line; do
      printf '%b%s%b\n' "$_GW_YELLOW" "$line" "$_GW_RESET"
    done
  else
    cat
  fi
}
WOKWIGW_BIN="$ROOT_DIR/.tools/wokwigw"
WOKWIGW_VERSION="v2.0.1"
WOKWIGW_ASSET=""
WOKWIGW_EXTRACTED="wokwigw"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)  WOKWIGW_ASSET="Linux_64bit"; WOKWIGW_EXTRACTED="wokwigw-linux" ;;
  Linux-aarch64|Linux-arm64) WOKWIGW_ASSET="Linux_ARM64"; WOKWIGW_EXTRACTED="wokwigw-linux" ;;
  Darwin-x86_64) WOKWIGW_ASSET="macOS_64bit"; WOKWIGW_EXTRACTED="wokwigw-darwin" ;;
  Darwin-arm64)  WOKWIGW_ASSET="macOS_ARM64"; WOKWIGW_EXTRACTED="wokwigw-darwin" ;;
  MINGW*|MSYS*|CYGWIN*) WOKWIGW_ASSET="Windows_64bit"; WOKWIGW_EXTRACTED="wokwigw.exe" ;;
esac
WOKWIGW_URL="https://github.com/wokwi/wokwigw/releases/download/${WOKWIGW_VERSION}/wokwigw_${WOKWIGW_VERSION}_${WOKWIGW_ASSET}.zip"

usage() {
  cat <<EOF
uso: ./dev <comando>

  ./dev                 esta ajuda
  ./dev up              backend Node + frontend Vite
  ./dev up --docker     Compose na raiz (anexado, Ctrl+C encerra)
  ./dev up --docker -d  Compose na raiz em background (sobrevive ao terminal)
  ./dev down            encerra o que este script deixou em :8787 / :5173
  ./dev down --docker   docker compose down
  ./dev wokwi           coletor + gateway Wokwi + compila o firmware simulado
                     (atalhos: simulador, sim)
  ./dev firmware build  compila a placa (esp32dev)
  ./dev firmware wokwi  só compila o env wokwi (não sobe o gateway)
  ./dev firmware flash  grava na ESP32
  ./dev firmware monitor
  ./dev app             app desktop (Electron) em desenvolvimento
  ./dev app build       instalador da plataforma atual (dist/)
  ./dev test            vitest + tsc (backend/frontend/desktop)
  ./dev lint            eslint + tsc
  ./dev release         publica os instaladores: tag + GitHub Actions
  ./dev release 1.0.2   sobe a versão antes de taguear
  ./dev release --dry   roda a matriz sem tocar em Releases (artifacts, 14 dias)
  ./dev release --status  acompanha a última execução

Ctrl+C encerra os processos que este script subiu.
EOF
}

find_pio() {
  if command -v pio >/dev/null 2>&1; then
    command -v pio
    return 0
  fi
  local bundled="$HOME/.platformio/penv/bin/pio"
  if [ -x "$bundled" ]; then
    printf '%s\n' "$bundled"
    return 0
  fi
  echo "erro: pio não encontrado. https://docs.platformio.org/" >&2
  exit 1
}

run_pio() {
  local pio
  pio="$(find_pio)"
  (cd "$ROOT_DIR/firmware" && "$pio" "$@")
}

# node_modules existir não basta: depois de um `git pull` que mexeu em
# package-lock.json, um node_modules velho fica lá parado e ninguém percebe
# até um require() sumido ou uma versão nativa (Electron etc) desalinhada
# quebrar algo em silêncio. npm grava node_modules/.package-lock.json com o
# que foi de fato instalado — comparamos com o lockfile do repo.
node_modules_stale() {
  local dir="$1"
  [ -d "$dir/node_modules" ] || return 0
  local lock="$dir/package-lock.json"
  [ -f "$lock" ] || return 1
  local marker="$dir/node_modules/.package-lock.json"
  [ -f "$marker" ] || return 0
  [ "$lock" -nt "$marker" ]
}

ensure_backend_node() {
  if node_modules_stale "$ROOT_DIR/backend"; then
    (cd "$ROOT_DIR/backend" && npm install)
  fi
}

ensure_node() {
  if node_modules_stale "$ROOT_DIR/frontend"; then
    (cd "$ROOT_DIR/frontend" && npm install)
  fi
}

# Compat: backend Python legado (se ainda existir em backend-python-legacy)
ensure_python() {
  if [ -d "$ROOT_DIR/backend-python-legacy/.venv" ]; then
    return 0
  fi
  if [ -d "$ROOT_DIR/backend/.venv" ] && [ -f "$ROOT_DIR/backend/.venv/bin/python" ]; then
    return 0
  fi
  # Node é o runtime atual; não cria venv
  return 0
}

ensure_frontend_dist() {
  # Sempre rebuilda: :8787 serve frontend/dist, e pular o build deixava o
  # mostrador da LAN / Wokwi com UI velha depois de mudar o React.
  ensure_node
  echo "== build frontend (painel na :${BACKEND_PORT} pra LAN / QR da placa) =="
  (cd "$ROOT_DIR/frontend" && npm run build)
}

ensure_wokwigw() {
  if [ -x "$WOKWIGW_BIN" ]; then
    return 0
  fi
  if [ -z "$WOKWIGW_ASSET" ]; then
    echo "plataforma não suportada: $(uname -s)-$(uname -m)" >&2
    echo "baixe manualmente em https://github.com/wokwi/wokwigw/releases/latest" >&2
    echo "e salve o binário em $WOKWIGW_BIN" >&2
    exit 1
  fi
  mkdir -p "$ROOT_DIR/.tools"
  echo "== baixando wokwigw para .tools/ =="
  if command -v curl >/dev/null 2>&1; then
    local tmpzip="$ROOT_DIR/.tools/wokwigw.zip"
    curl -fsSL -o "$tmpzip" "$WOKWIGW_URL" || {
      echo "falha no download. baixe em https://github.com/wokwi/wokwigw/releases/latest" >&2
      echo "e salve o binário em $WOKWIGW_BIN" >&2
      rm -f "$tmpzip"
      exit 1
    }
    if command -v unzip >/dev/null 2>&1; then
      unzip -qo "$tmpzip" -d "$ROOT_DIR/.tools/"
    else
      python3 -c "import zipfile,sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" "$tmpzip" "$ROOT_DIR/.tools/"
    fi
    # O zip contém um binário com nome específico por plataforma
    # (wokwigw-linux, wokwigw-darwin, wokwigw.exe).
    local extracted="$ROOT_DIR/.tools/$WOKWIGW_EXTRACTED"
    if [ -f "$extracted" ]; then
      mv "$extracted" "$WOKWIGW_BIN"
    fi
    rm -f "$tmpzip"
    # Limpa outros arquivos extraídos do zip
    rm -f "$ROOT_DIR/.tools"/wokwigw_* "$ROOT_DIR/.tools"/README* "$ROOT_DIR/.tools"/LICENSE* 2>/dev/null || true
  else
    echo "curl não encontrado; baixe wokwigw em https://github.com/wokwi/wokwigw/releases/latest" >&2
    exit 1
  fi
  chmod +x "$WOKWIGW_BIN"
}

warn_secrets() {
  local secrets="$ROOT_DIR/firmware/src/secrets.h"
  if [ ! -f "$secrets" ]; then
    echo "aviso: firmware/src/secrets.h não existe — cp firmware/src/secrets.h.example firmware/src/secrets.h" >&2
    echo ""
  fi
}

listen_pids() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null || true
}

require_port_free() {
  local port="$1"
  local name="$2"
  local pids
  pids="$(listen_pids "$port")"
  if [ -n "$pids" ]; then
    echo "erro: porta $port ($name) já está em uso — pid(s): $(echo "$pids" | tr '\n' ' ')" >&2
    echo "      encerre o outro processo (Ctrl+C naquele terminal) ou rode: ./dev down" >&2
    exit 1
  fi
}

PIDS=()
cleanup() {
  trap - INT TERM EXIT
  echo ""
  echo "encerrando..."
  for pid in "${PIDS[@]:-}"; do
    kill -TERM "$pid" 2>/dev/null || true
  done
  sleep 1
  for pid in "${PIDS[@]:-}"; do
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}

run_backend() {
  ensure_backend_node
  ensure_frontend_dist
  # Sempre rebuilda: como no frontend, pular quando o dist já existe deixava
  # rotas/campos novos faltando depois de um pull (ex.: git/calendar/notes
  # ausentes do dist enquanto o frontend já esperava por eles).
  echo "== build backend =="
  (cd "$ROOT_DIR/backend" && npm run build)
  echo "== backend Node :${BACKEND_PORT} (Swagger em /docs) =="
  (
    cd "$ROOT_DIR/backend"
    exec node dist/main.js
  ) &
  local backend_pid=$!
  PIDS+=("$backend_pid")
  local i
  for i in $(seq 1 20); do
    if curl -sf -o /dev/null "http://127.0.0.1:${BACKEND_PORT}/health"; then
      return 0
    fi
    if ! kill -0 "$backend_pid" 2>/dev/null; then
      echo "erro: backend saiu antes de responder em /health (porta ${BACKEND_PORT} ocupada?)." >&2
      exit 1
    fi
    sleep 0.25
  done
  echo "erro: backend não respondeu em http://127.0.0.1:${BACKEND_PORT}/health" >&2
  exit 1
}

run_frontend() {
  ensure_node
  echo "== frontend Vite :${FRONTEND_PORT} (proxy para o backend) =="
  (
    cd "$ROOT_DIR/frontend"
    exec npm run dev -- --host 127.0.0.1 --port "$FRONTEND_PORT" --strictPort
  ) &
  PIDS+=("$!")
}

ours_on_port() {
  # Só os processos deste repo: node dist/main.js (8787) e Vite (5173), + legado Python.
  local pid="$1"
  local cmd
  cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  case "$cmd" in
    *"/backend/"*"app.main"*|*python*" -m app.main"*) return 0 ;;
    *"node"*dist/main.js*|*"node"*dist/desktop.js*|*"backend/dist"*) return 0 ;;
    *"vite"*|*"vigia-ai-frontend"*|*"frontend/node_modules"*) return 0 ;;
  esac
  return 1
}

cmd_down() {
  if [ "${1:-}" = "--docker" ]; then
    if ! command -v docker >/dev/null 2>&1; then
      echo "docker não encontrado." >&2
      exit 1
    fi
    exec docker compose -f "$ROOT_DIR/compose.yaml" down
  fi
  local pid port killed=0
  for port in "$BACKEND_PORT" "$FRONTEND_PORT"; do
    for pid in $(listen_pids "$port"); do
      if ours_on_port "$pid"; then
        echo "encerrando pid $pid (porta $port)"
        kill -TERM "$pid" 2>/dev/null || true
        killed=1
      else
        echo "aviso: porta $port em uso por pid $pid (não é deste repo) — não encerrado" >&2
      fi
    done
  done
  if [ "$killed" -eq 0 ]; then
    echo "nada deste repo escutando em :${BACKEND_PORT} / :${FRONTEND_PORT}"
    return 0
  fi
  sleep 1
  for port in "$BACKEND_PORT" "$FRONTEND_PORT"; do
    for pid in $(listen_pids "$port"); do
      if ours_on_port "$pid"; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    done
  done
  echo "portas livres."
}

cmd_up() {
  local docker_mode=0 detach=0
  for arg in "$@"; do
    case "$arg" in
      --docker) docker_mode=1 ;;
      -d|--detach) detach=1 ;;
    esac
  done
  if [ "$docker_mode" -eq 1 ]; then
    if ! command -v docker >/dev/null 2>&1; then
      echo "docker não encontrado." >&2
      exit 1
    fi
    echo "painel: http://127.0.0.1:${BACKEND_PORT}/display/config"
    if [ "$detach" -eq 1 ]; then
      docker compose -f "$ROOT_DIR/compose.yaml" up --build -d
      echo "rodando em background. 'docker compose logs -f' pra ver logs, './dev down --docker' pra parar."
      exit 0
    fi
    exec docker compose -f "$ROOT_DIR/compose.yaml" up --build
  fi
  require_port_free "$BACKEND_PORT" "backend"
  require_port_free "$FRONTEND_PORT" "frontend Vite"
  trap cleanup INT TERM EXIT
  run_backend
  run_frontend
  echo ""
  echo "painel     http://127.0.0.1:${FRONTEND_PORT}/display/config"
  echo "mostrador  http://127.0.0.1:${FRONTEND_PORT}/display"
  echo "swagger    http://127.0.0.1:${BACKEND_PORT}/docs"
  echo "Ctrl+C encerra."
  wait
}

cmd_sim() {
  trap cleanup INT TERM EXIT
  ensure_wokwigw
  echo "== gateway wokwigw :9011 =="
  if nc -z 127.0.0.1 9011 2>/dev/null; then
    echo "gateway ja esta em :9011"
  else
    "$WOKWIGW_BIN" --listenPort 9011 2>&1 | colorize_gateway &
    PIDS+=("$!")
    local i
    for i in $(seq 1 20); do
      if nc -z 127.0.0.1 9011 2>/dev/null; then
        break
      fi
      sleep 0.15
    done
  fi
  echo "== compilando firmware wokwi =="
  run_pio run -e wokwi
  if curl -sf -o /dev/null "http://127.0.0.1:${BACKEND_PORT}/health"; then
    echo "== backend ja esta em :${BACKEND_PORT} (reusa o ./dev up) =="
    ensure_frontend_dist
  else
    require_port_free "$BACKEND_PORT" "backend"
    run_backend
  fi
  echo ""
  echo "1. Se o simulador já estiver aberto: pare (Stop) e inicie de novo."
  echo "2. Cmd+Shift+P → Wokwi: Start Simulator"
  echo "3. Neste terminal deve aparecer: Client connected"
  echo "   se não aparecer, o Wokwi não está usando o gateway."
  echo ""
  echo "Editor de tema (/display/theme) na placa simulada: IP \"127.0.0.1:${THEME_SIM_PORT}\""
  echo "(o coletor detecta a placa como 127.0.0.1 — completa a porta à mão nesse campo)."
  echo "Ctrl+C encerra o gateway (e o backend, se este script o tiver subido)."
  wait
}

cmd_test() {
  ensure_backend_node
  if [ -f "$ROOT_DIR/backend/package.json" ]; then
    (cd "$ROOT_DIR/backend" && npm run typecheck)
    if grep -q '"test"' "$ROOT_DIR/backend/package.json"; then
      (cd "$ROOT_DIR/backend" && npm test 2>&1 | head -n 100) || echo "(backend tests falharam ou vitest não configurado — verifique)"
    fi
  fi
  ensure_node
  (cd "$ROOT_DIR/frontend" && npx tsc --noEmit)
  if [ -d "$ROOT_DIR/desktop/node_modules" ]; then
    (cd "$ROOT_DIR/desktop" && npm run typecheck)
  else
    echo "(pulando o typecheck do desktop: rode ./dev app uma vez)"
  fi
}

cmd_lint() {
  ensure_backend_node
  if [ -f "$ROOT_DIR/backend/package.json" ]; then
    (cd "$ROOT_DIR/backend" && npm run lint)
  fi
  ensure_node
  (cd "$ROOT_DIR/frontend" && npx tsc --noEmit)
  if [ -d "$ROOT_DIR/desktop/node_modules" ]; then
    (cd "$ROOT_DIR/desktop" && npm run typecheck 2>&1 | head -n 20)
  fi
}

electron_binary_path() {
  local dir="$1"
  case "$(uname -s)" in
    Darwin) echo "$dir/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron" ;;
    Linux)  echo "$dir/node_modules/electron/dist/electron" ;;
    *)      echo "$dir/node_modules/electron/dist/electron.exe" ;;
  esac
}

# O instalador do pacote `electron` (extract-zip) já foi visto saindo com
# código 0 tendo extraído só o primeiro arquivo do zip — node_modules/electron
# fica sem o binário nativo (path.txt ausente) e o app sobe com um Electron
# de outra instalação, ou nem sobe. O zip baixado já teve o checksum validado
# pelo instalador, então extrair de novo na mão é seguro.
fix_electron_binary() {
  local dir="$1"
  [ -d "$dir/node_modules/electron" ] || return 0
  local bin
  bin="$(electron_binary_path "$dir")"
  [ -x "$bin" ] && return 0

  echo "== electron instalou sem o binário nativo — extraindo de novo =="
  local ver cache_dir zip
  ver="$(node -e "console.log(require('$dir/node_modules/electron/package.json').version)" 2>/dev/null || true)"
  case "$(uname -s)" in
    Darwin) cache_dir="$HOME/Library/Caches/electron" ;;
    Linux)  cache_dir="$HOME/.cache/electron" ;;
    *)      cache_dir="" ;;
  esac
  if [ -n "$cache_dir" ] && [ -n "$ver" ] && command -v unzip >/dev/null 2>&1; then
    zip="$(find "$cache_dir" -iname "electron-v${ver}-*.zip" 2>/dev/null | head -1)"
    if [ -n "$zip" ]; then
      rm -rf "$dir/node_modules/electron/dist"
      mkdir -p "$dir/node_modules/electron/dist"
      unzip -qo "$zip" -d "$dir/node_modules/electron/dist"
      printf '%s' "${bin#"$dir/node_modules/electron/dist/"}" > "$dir/node_modules/electron/path.txt"
      chmod +x "$bin" 2>/dev/null || true
    fi
  fi
  if [ ! -x "$bin" ]; then
    echo "erro: não consegui extrair o binário do electron (esperado em $bin)." >&2
    echo "      rode: cd desktop && rm -rf node_modules/electron && npm install electron --no-save" >&2
    exit 1
  fi
}

ensure_desktop_node() {
  if node_modules_stale "$ROOT_DIR/desktop"; then
    (cd "$ROOT_DIR/desktop" && npm install)
  fi
  fix_electron_binary "$ROOT_DIR/desktop"
}

cmd_app() {
  ensure_backend_node
  echo "== build backend (bundle pro Electron) =="
  (cd "$ROOT_DIR/backend" && npm run build)
  ensure_frontend_dist
  ensure_desktop_node
  echo "== app desktop (Electron) =="
  # Se já houver um coletor em :8787, o app se conecta a ele em vez de subir outro.
  (cd "$ROOT_DIR/desktop" && npm run build && ./node_modules/.bin/electron out/main.js)
}

cmd_app_build() {
  ensure_backend_node
  echo "== build backend (bundle pro Electron) =="
  (cd "$ROOT_DIR/backend" && npm run build)
  ensure_desktop_node
  echo "== instalador do app desktop =="
  echo "   (o coletor Node é empacotado como JS — sem binário nativo por SO)"
  "$ROOT_DIR/scripts/build-collector.sh" || true
  "$ROOT_DIR/scripts/build-desktop.sh" "$@"
}

RELEASE_WORKFLOW="release-desktop.yml"

# A versão que o electron-builder usa para nomear o release. NÃO é a tag: ele
# lê o package.json. Se os dois divergirem, os artefatos vão parar num release
# que ninguém está olhando — por isso o comando abaixo força a igualdade.
desktop_version() {
  sed -n 's/.*"version": "\([^"]*\)".*/\1/p' "$ROOT_DIR/desktop/package.json" | head -1
}

ensure_gh() {
  command -v gh >/dev/null 2>&1 || {
    echo "erro: gh (GitHub CLI) não encontrado — instale com: brew install gh" >&2
    exit 1
  }
  gh auth status >/dev/null 2>&1 || {
    echo "erro: gh não autenticado — rode: gh auth login" >&2
    exit 1
  }
}

release_guards() {
  local branch local_sha remote_sha
  branch="$(git -C "$ROOT_DIR" branch --show-current)"

  # Uma tag aponta para um commit. Se a árvore está suja, o que você testou
  # não é o que vai ser compilado nos runners.
  if ! git -C "$ROOT_DIR" diff --quiet || ! git -C "$ROOT_DIR" diff --cached --quiet; then
    echo "erro: há mudanças não commitadas — a tag apontaria para outro estado" >&2
    git -C "$ROOT_DIR" status --short >&2
    exit 1
  fi

  # O runner clona do origin: um commit só local vira uma tag órfã lá.
  git -C "$ROOT_DIR" fetch -q origin "$branch" 2>/dev/null || true
  local_sha="$(git -C "$ROOT_DIR" rev-parse HEAD)"
  remote_sha="$(git -C "$ROOT_DIR" rev-parse "origin/$branch" 2>/dev/null || echo "")"
  if [ "$local_sha" != "$remote_sha" ]; then
    echo "erro: $branch não está sincronizada com origin/$branch" >&2
    echo "      rode: git push origin $branch" >&2
    exit 1
  fi
}

cmd_release() {
  local dry=0 status=0 skip_tests=0 want="" tag version branch
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry|--dry-run) dry=1 ;;
      --status) status=1 ;;
      --skip-tests) skip_tests=1 ;;
      -*) echo "opção desconhecida: $1" >&2; exit 1 ;;
      *) want="$1" ;;
    esac
    shift
  done
  ensure_gh
  branch="$(git -C "$ROOT_DIR" branch --show-current)"

  if [ "$status" -eq 1 ]; then
    local runs
    runs="$(gh run list --workflow "$RELEASE_WORKFLOW" --limit 5 2>/dev/null || true)"
    if [ -z "$runs" ]; then
      echo "nenhuma execução de $RELEASE_WORKFLOW até agora."
      echo "dispare com: ./dev release   (ou ./dev release --dry para ensaiar)"
      return 0
    fi
    echo "$runs"
    echo
    echo "detalhe de uma run:  gh run view <id>"
    echo "acompanhar ao vivo:  gh run watch <id>"
    return 0
  fi

  if [ "$dry" -eq 1 ]; then
    echo "== ensaio: matriz completa, sem tocar em Releases =="
    echo "   (os instaladores ficam como artifacts da run por 14 dias)"
    gh workflow run "$RELEASE_WORKFLOW" --ref "$branch" -f publish=false
    echo
    echo "acompanhe com: ./dev release --status"
    return 0
  fi

  # Bump opcional. Feito antes das travas para a árvore ficar limpa de novo.
  if [ -n "$want" ] && [ "$want" != "$(desktop_version)" ]; then
    echo "== versão $(desktop_version) → $want =="
    (cd "$ROOT_DIR/desktop" && npm version "$want" --no-git-tag-version >/dev/null)
    git -C "$ROOT_DIR" add desktop/package.json desktop/package-lock.json
    git -C "$ROOT_DIR" commit -q -m "chore(desktop): versão $want"
    git -C "$ROOT_DIR" push -q origin "$branch"
  fi

  version="$(desktop_version)"
  tag="v$version"

  release_guards

  if git -C "$ROOT_DIR" rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    echo "erro: a tag $tag já existe localmente" >&2
    echo "      apague com: git tag -d $tag" >&2
    exit 1
  fi
  if git -C "$ROOT_DIR" ls-remote --exit-code --tags origin "$tag" >/dev/null 2>&1; then
    echo "erro: a tag $tag já existe no origin — suba a versão em vez de reusá-la" >&2
    exit 1
  fi

  if [ "$skip_tests" -eq 0 ]; then
    echo "== testes antes de publicar (pule com --skip-tests) =="
    cmd_test
  fi

  echo "== tag $tag em $(git -C "$ROOT_DIR" rev-parse --short HEAD) ($branch) =="
  git -C "$ROOT_DIR" tag -a "$tag" -m "Vigia AI $version"
  git -C "$ROOT_DIR" push -q origin "$tag"

  cat <<MSG

Tag publicada. A matriz de 4 runners começou (macOS arm64/x64, Windows, Linux)
— cada um compila o próprio sidecar, então leva alguns minutos.

  ./dev release --status     acompanhar

O release nasce como RASCUNHO: quando a matriz terminar, revise os artefatos e
clique em "Publish release". Sem os secrets de assinatura os binários saem sem
assinar — vale dizer isso no corpo do release.

  gh release view $tag --web
MSG
}

if [ $# -lt 1 ]; then
  usage
  exit 0
fi

case "$1" in
  -h|--help|help) usage ;;
  up) shift; cmd_up "$@" ;;
  down) shift; cmd_down "$@" ;;
  wokwi|simulador|sim) cmd_sim ;;
  test) cmd_test ;;
  lint) cmd_lint ;;
  release) shift; cmd_release "$@" ;;
  app)
    shift
    case "${1:-}" in
      "") cmd_app ;;
      build) shift; cmd_app_build "$@" ;;
      *)
        echo "uso: ./dev app [build]" >&2
        exit 1
        ;;
    esac
    ;;
  firmware)
    shift
    case "${1:-}" in
      build) warn_secrets; run_pio run -e esp32dev ;;
      wokwi) run_pio run -e wokwi ;;
      flash|upload) warn_secrets; run_pio run -e esp32dev -t upload ;;
      monitor) run_pio device monitor -b "$MONITOR_BAUD" ;;
      *)
        echo "uso: ./dev firmware {build|wokwi|flash|monitor}" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "comando desconhecido: $1" >&2
    usage >&2
    exit 1
    ;;
esac
