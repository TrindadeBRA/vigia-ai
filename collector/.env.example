HOST=0.0.0.0
PORT=8787

# Copie este arquivo para .env (gitignored) e preencha o que for override.
# Sem token, o coletor lê Claude Code (Keychain / credentials.json) e o Cursor (state.vscdb).
# OpenRouter não tem app local — cole a key (https://openrouter.ai/settings/keys).
#
#   python3 gerar_env_claude.py   →  CLAUDE_OAUTH_TOKEN no .env
#   python3 gerar_env_cursor.py   →  CURSOR_ACCESS_TOKEN no .env

CLAUDE_OAUTH_TOKEN=
# CLAUDE_CREDENTIALS_PATH=

CURSOR_ACCESS_TOKEN=
# CURSOR_STATE_DB=

OPENROUTER_API_KEY=

# COLLECTOR_MOCK=0
